{
  "name": "eypassiai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:domain": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build && node scripts/prepare-pages.mjs",
    "check:pages": "node scripts/verify-pages.mjs",
    "test": "node --test src/ai-consent.test.mjs src/ai-context.test.mjs src/ai-invoke.test.mjs src/auth-callback-route.test.mjs src/storage-notice-state.test.mjs src/file-operations.test.mjs src/ai-proposal.test.mjs src/password-recovery.test.mjs src/web-remediation.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "local-domain:on": "bash scripts/enable-local-domain.sh",
    "local-domain:off": "bash scripts/disable-local-domain.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.0",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3"
  }
}
